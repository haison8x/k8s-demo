# nginx server for the K8s Demo page. The stock nginx entrypoint substitutes
# ${ENV_NAME}, ${ENV_COLOR}, ${APP_VERSION} and ${APP_MESSAGE} at start-up;
# $hostname is resolved by nginx on each request (the pod name).
server {
    listen 80;
    server_name _;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 'ok';
    }

    location / {
        default_type text/html;
        add_header Cache-Control "no-store";
        return 200 '<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>K8s Demo - ${ENV_NAME}</title>
<style>
  body { margin: 0; min-height: 100vh; display: flex; align-items: center; justify-content: center;
         font-family: system-ui, -apple-system, "Segoe UI", sans-serif; background: #f4f6f8; color: #1f2933; }
  main { background: #fff; border-radius: 16px; box-shadow: 0 10px 30px rgba(0, 0, 0, .08);
         padding: 40px 32px; text-align: center; width: calc(100% - 32px); max-width: 520px; box-sizing: border-box; }
  .env { display: inline-block; background: ${ENV_COLOR}; color: #fff; font-weight: 700;
         letter-spacing: .08em; padding: 6px 16px; border-radius: 999px; }
  h1 { font-size: 44px; margin: 20px 0 8px; }
  .version { color: #52606d; margin: 0; }
  .message { font-size: 20px; margin: 24px 0; }
  .pod { font-family: ui-monospace, Consolas, monospace; background: #eef2f6; padding: 8px 12px;
         border-radius: 8px; display: inline-block; margin: 0; }
  @media (prefers-color-scheme: dark) {
    body { background: #111827; color: #e5e7eb; }
    main { background: #1f2937; }
    .version { color: #9ca3af; }
    .pod { background: #374151; }
  }
</style>
</head>
<body>
<main>
  <span class="env">${ENV_NAME}</span>
  <h1>K8s Demo</h1>
  <p class="version">Version ${APP_VERSION}</p>
  <p class="message">${APP_MESSAGE}</p>
  <p class="pod">Served by pod: $hostname</p>
</main>
</body>
</html>
';
    }
}
