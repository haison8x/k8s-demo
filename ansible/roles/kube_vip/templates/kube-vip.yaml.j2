# Managed by Ansible (k8s-demo). Holds the API server VIP {{ kube_vip_address }}.
apiVersion: v1
kind: Pod
metadata:
  name: kube-vip
  namespace: kube-system
spec:
  hostNetwork: true
  hostAliases:
    - hostnames: [kubernetes]
      ip: 127.0.0.1
  containers:
    - name: kube-vip
      image: ghcr.io/kube-vip/kube-vip:{{ kube_vip_version }}
      imagePullPolicy: IfNotPresent
      args: [manager]
      env:
        - {name: vip_arp, value: "true"}
        - {name: port, value: "{{ kube_apiserver_port }}"}
        - {name: vip_interface, value: "{{ kube_vip_interface }}"}
        - {name: vip_subnet, value: "32"}
        - {name: cp_enable, value: "true"}
        - {name: cp_namespace, value: kube-system}
        - {name: svc_enable, value: "false"}
        - {name: vip_leaderelection, value: "true"}
        - {name: vip_leasename, value: plndr-cp-lock}
        - {name: vip_leaseduration, value: "5"}
        - {name: vip_renewdeadline, value: "3"}
        - {name: vip_retryperiod, value: "1"}
        - {name: address, value: "{{ kube_vip_address }}"}
      securityContext:
        capabilities:
          drop: [ALL]
          add: [NET_ADMIN, NET_RAW]
      volumeMounts:
        - name: kubeconfig
          mountPath: /etc/kubernetes/admin.conf
  volumes:
    - name: kubeconfig
      hostPath:
        path: {{ kube_vip_kubeconfig }}
